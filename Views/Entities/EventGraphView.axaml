<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ent="using:HoI4ModBuilder.ViewModels.Entities"
             xmlns:graph="using:HoI4ModBuilder.Views.Graph"
             xmlns:views="using:HoI4ModBuilder.Views.Entities"
             xmlns:conv="using:HoI4ModBuilder.Views.Converters"
             xmlns:gv="using:HoI4ModBuilder.Views"
             x:Class="HoI4ModBuilder.Views.Entities.EventGraphView"
             x:DataType="ent:EventGraphTabViewModel">
  <UserControl.Styles>
    <!-- Problems found by the mod check -->
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="#E61E1F22" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="2" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource PanelBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.card.root">
      <Setter Property="BorderBrush" Value="#C9B37E" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.card.missing">
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}" />
    </Style>
    <Style Selector="Border.card.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.option">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="10,5,10,0" />
    </Style>
    <Style Selector="Border.option:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Border.option.selected">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,1,340">
    <DockPanel>
      <!-- Toolbar -->
      <Border DockPanel.Dock="Top" Height="34" Padding="8,0"
              BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*">
          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Classes="flat" Padding="5" MinHeight="0" Click="OnZoomOut" ToolTip.Tip="Зменшити (коліщатко)">
              <PathIcon Data="{StaticResource IconMinus}" Width="12" Height="12" />
            </Button>
            <TextBlock x:Name="ZoomText" Width="48" TextAlignment="Center" VerticalAlignment="Center"
                       Classes="secondary" FontSize="12" />
            <Button Classes="flat" Padding="5" MinHeight="0" Click="OnZoomIn" ToolTip.Tip="Збільшити (коліщатко)">
              <PathIcon Data="{StaticResource IconPlus}" Width="12" Height="12" />
            </Button>
            <Button Classes="flat" Padding="8,3" MinHeight="0" Margin="6,0,0,0" Content="Вмістити" Click="OnFit" />
            <Border Width="1" Height="16" Margin="8,0" Background="{DynamicResource SeparatorBrush}" />
            <Button Classes="flat" Padding="8,3" MinHeight="0" Command="{Binding AddOptionCommand}"
                    ToolTip.Tip="Новий варіант">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconPlus}" Width="11" Height="11" />
                <TextBlock Text="Варіант" />
              </StackPanel>
            </Button>
            <Button Classes="flat" Padding="8,3" MinHeight="0" Command="{Binding AddFollowUpEventCommand}"
                    ToolTip.Tip="Нова подія-наслідок">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconEvent}" Width="11" Height="11" />
                <TextBlock Text="Подія-наслідок" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Panel>
        <graph:GraphSurface x:Name="Surface" Background="{DynamicResource WindowBgBrush}"
                            ViewTransform="{Binding ViewTransform}">
          <Canvas x:Name="World" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
            <graph:GraphEdgesControl Edges="{Binding Edges}" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" />
            <ItemsControl ItemsSource="{Binding Nodes}" Classes="graph-nodes"
                          Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
              <ItemsControl.Styles>
                <Style Selector="ItemsControl.graph-nodes > ContentPresenter" x:DataType="ent:GraphNodeViewModel">
                  <Setter Property="Canvas.Left" Value="{Binding X}" />
                  <Setter Property="Canvas.Top" Value="{Binding Y}" />
                </Style>
              </ItemsControl.Styles>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <Canvas />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.DataTemplates>
                <!-- An event: picture, title, then one row per option -->
                <DataTemplate DataType="ent:EventNodeViewModel">
                  <Border Classes="card" Classes.root="{Binding IsRoot}" Classes.missing="{Binding IsMissing}"
                          Classes.selected="{Binding IsSelected}" Width="{Binding Width}" Height="{Binding Height}">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Додати варіант"
                                  Command="{Binding $parent[UserControl].((ent:EventGraphTabViewModel)DataContext).AddOptionCommand}"
                                  CommandParameter="{Binding}" IsEnabled="{Binding !IsMissing}" />
                        <MenuItem Header="Відкрити в коді"
                                  Command="{Binding $parent[UserControl].((ent:EventGraphTabViewModel)DataContext).OpenSelectionInCodeCommand}"
                                  IsEnabled="{Binding !IsMissing}" />
                      </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel>
                      <Panel>
                      <Border Classes="badge" Classes.error="{Binding HasError}" IsVisible="{Binding HasProblems}"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                              ToolTip.Tip="{Binding ProblemText}">
                        <PathIcon Width="14" Height="14"
                                  Data="{Binding Severity, Converter={x:Static conv:ProblemIcons.Geometry}}"
                                  Foreground="{Binding Severity, Converter={x:Static conv:ProblemIcons.Brush}}" />
                      </Border>
                      <Grid Height="86" ColumnDefinitions="Auto,*" Margin="8,8,10,0" VerticalAlignment="Top">
                        <Border Width="92" Height="70" CornerRadius="3" ClipToBounds="True" Margin="0,0,10,0"
                                Background="{DynamicResource WindowBgBrush}">
                          <Panel>
                            <Image Source="{Binding Picture}" Stretch="UniformToFill" />
                            <PathIcon Data="{StaticResource IconEvent}" Width="22" Height="22"
                                      Foreground="{DynamicResource ContentIconEventBrush}"
                                      IsVisible="{Binding Picture, Converter={x:Static ObjectConverters.IsNull}}" />
                          </Panel>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Id}" FontFamily="{StaticResource EditorFont}" FontSize="11"
                                     Classes="secondary" />
                          <TextBlock Text="{Binding Flags}" FontSize="11" Classes="secondary" TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding HasFlags}" />
                        </StackPanel>
                      </Grid>
                      </Panel>
                      <ItemsControl ItemsSource="{Binding Options}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="ent:EventOptionViewModel">
                            <Border Classes="option" Classes.selected="{Binding IsSelected}" Height="{Binding Height}">
                              <Border.ContextMenu>
                                <ContextMenu>
                                  <MenuItem Header="Створити подію-наслідок"
                                            Command="{Binding $parent[UserControl].((ent:EventGraphTabViewModel)DataContext).AddFollowUpEventCommand}"
                                            CommandParameter="{Binding}" />
                                  <MenuItem Header="Відкрити в коді"
                                            Command="{Binding $parent[UserControl].((ent:EventGraphTabViewModel)DataContext).OpenSelectionInCodeCommand}" />
                                </ContextMenu>
                              </Border.ContextMenu>
                              <StackPanel Spacing="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <TextBlock Text="▸" Foreground="#C9B37E" />
                                  <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" MaxWidth="250" />
                                </StackPanel>
                                <gv:GameTextBlock Runs="{Binding Effects}" IsVisible="{Binding HasEffects}"
                                                  FontSize="11" LineHeight="16" TextWrapping="NoWrap"
                                                  Classes="secondary" TextTrimming="CharacterEllipsis" Margin="16,0,0,0" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>

                <!-- What fires the event: a focus, a decision… -->
                <DataTemplate DataType="ent:EventSourceNodeViewModel">
                  <Border Classes="card" Classes.selected="{Binding IsSelected}"
                          Width="{Binding Width}" Height="{Binding Height}" Padding="10,8">
                    <Grid ColumnDefinitions="Auto,*">
                      <PathIcon Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"
                                Data="{Binding SourceKind, Converter={x:Static conv:ContentIcons.Geometry}}"
                                Foreground="{Binding SourceKind, Converter={x:Static conv:ContentIcons.Brush}}" />
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Caption}" FontSize="11" Classes="secondary" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.DataTemplates>
            </ItemsControl>
          </Canvas>
        </graph:GraphSurface>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                    IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <PathIcon Data="{StaticResource IconWarning}" Width="20" Height="20" Foreground="{DynamicResource ErrorBrush}" />
          <TextBlock Text="{Binding Error}" Classes="secondary" TextWrapping="Wrap" MaxWidth="480" TextAlignment="Center" />
        </StackPanel>
      </Panel>
    </DockPanel>

    <Border Grid.Column="1" Background="{DynamicResource SeparatorBrush}" />

    <Panel Grid.Column="2" Background="{DynamicResource PanelBgBrush}">
      <views:PropertyPanel DataContext="{Binding Panel}"
                           IsVisible="{Binding $parent[UserControl].((ent:EventGraphTabViewModel)DataContext).Panel, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </Panel>
  </Grid>
</UserControl>
